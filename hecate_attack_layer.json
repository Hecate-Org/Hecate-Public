{
  "name": "Hecate Detection Coverage",
  "domain": "enterprise-attack",
  "description": "MITRE ATT&CK coverage exported from Hecate (scored by hunts)",
  "versions": {
    "layer": "4.5",
    "attack": "19.1",
    "navigator": "5.0.0"
  },
  "filters": {
    "platforms": [
      "Linux",
      "macOS",
      "Windows"
    ]
  },
  "layout": {
    "layout": "side",
    "showID": false,
    "showName": true,
    "showAggregateScores": true,
    "countUnscored": false,
    "aggregateFunction": "average"
  },
  "hideDisabled": false,
  "gradient": {
    "colors": [
      "#ffffff",
      "#6baed6",
      "#08519c"
    ],
    "minValue": 0,
    "maxValue": 2
  },
  "legendItems": [
    {
      "label": "No coverage (0)",
      "color": "#ffffff"
    },
    {
      "label": "Low coverage (1 hunt)",
      "color": "#6baed6"
    },
    {
      "label": "High coverage (1+ hunts)",
      "color": "#08519c"
    }
  ],
  "showTacticRowBackground": false,
  "tacticRowBackground": "#dddddd",
  "selectTechniquesAcrossTactics": true,
  "selectSubtechniquesWithParent": false
}