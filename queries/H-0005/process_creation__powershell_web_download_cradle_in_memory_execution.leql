where((process.exe_path=/^.*\\powershell\.exe$/i OR process.exe_path=/^.*\\pwsh\.exe$/i) AND (process.cmd_line=/^.*DownloadString.*$/i OR process.cmd_line=/^.*DownloadFile.*$/i OR process.cmd_line=/^.*DownloadData.*$/i OR process.cmd_line=/^.*Invoke-WebRequest.*$/i OR process.cmd_line=/^.*Invoke-RestMethod.*$/i OR process.cmd_line=/^.*Net\.WebClient.*$/i OR process.cmd_line=/^.*Start-BitsTransfer.*$/i) AND (process.cmd_line=/^.*IEX.*$/i OR process.cmd_line=/^.*Invoke-Expression.*$/i OR process.cmd_line=/^.*\.Invoke\(.*$/i))
