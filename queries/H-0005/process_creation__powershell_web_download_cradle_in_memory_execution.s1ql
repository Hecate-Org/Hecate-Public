EventType = "Process Creation" AND (EndpointOS = "windows" AND ((TgtProcImagePath endswithCIS "\powershell.exe" OR TgtProcImagePath endswithCIS "\pwsh.exe") AND (TgtProcCmdLine containsCIS "DownloadString" OR TgtProcCmdLine containsCIS "DownloadFile" OR TgtProcCmdLine containsCIS "DownloadData" OR TgtProcCmdLine containsCIS "Invoke-WebRequest" OR TgtProcCmdLine containsCIS "Invoke-RestMethod" OR TgtProcCmdLine containsCIS "Net.WebClient" OR TgtProcCmdLine containsCIS "Start-BitsTransfer") AND (TgtProcCmdLine containsCIS "IEX" OR TgtProcCmdLine containsCIS "Invoke-Expression" OR TgtProcCmdLine containsCIS ".Invoke(")))
