where((process.exe_path=/^.*\\powershell\.exe$/i OR process.exe_path=/^.*\\pwsh\.exe$/i) AND (process.cmd_line=/^.*-w hidden.*$/i OR process.cmd_line=/^.*-windowstyle hidden.*$/i OR process.cmd_line=/^.*-window hidden.*$/i OR process.cmd_line=/^.*-enc .*$/i OR process.cmd_line=/^.*-encodedcommand .*$/i) AND (process.cmd_line=/^.*http:\/\/.*$/i OR process.cmd_line=/^.*https:\/\/.*$/i OR process.cmd_line=/^.*WebClient.*$/i OR process.cmd_line=/^.*Download.*$/i OR process.cmd_line=/^.*irm .*$/i OR process.cmd_line=/^.*iwr .*$/i))
