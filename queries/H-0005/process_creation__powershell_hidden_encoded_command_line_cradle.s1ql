EventType = "Process Creation" AND (EndpointOS = "windows" AND ((TgtProcImagePath endswithCIS "\powershell.exe" OR TgtProcImagePath endswithCIS "\pwsh.exe") AND (TgtProcCmdLine containsCIS "-w hidden" OR TgtProcCmdLine containsCIS "-windowstyle hidden" OR TgtProcCmdLine containsCIS "-window hidden" OR TgtProcCmdLine containsCIS "-enc " OR TgtProcCmdLine containsCIS "-encodedcommand ") AND (TgtProcCmdLine containsCIS "http://" OR TgtProcCmdLine containsCIS "https://" OR TgtProcCmdLine containsCIS "WebClient" OR TgtProcCmdLine containsCIS "Download" OR TgtProcCmdLine containsCIS "irm " OR TgtProcCmdLine containsCIS "iwr ")))
