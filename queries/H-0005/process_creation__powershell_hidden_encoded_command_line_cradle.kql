DeviceProcessEvents
| where (FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and (ProcessCommandLine contains "-w hidden" or ProcessCommandLine contains "-windowstyle hidden" or ProcessCommandLine contains "-window hidden" or ProcessCommandLine contains "-enc " or ProcessCommandLine contains "-encodedcommand ") and (ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://" or ProcessCommandLine contains "WebClient" or ProcessCommandLine contains "Download" or ProcessCommandLine contains "irm " or ProcessCommandLine contains "iwr ")
