EventType = "Process Creation" AND (EndpointOS = "windows" AND ((TgtProcImagePath endswithCIS "\cmd.exe" OR TgtProcImagePath endswithCIS "\powershell.exe" OR TgtProcImagePath endswithCIS "\pwsh.exe") AND (TgtProcCmdLine containsCIS "copy " OR TgtProcCmdLine containsCIS "Copy-Item" OR TgtProcCmdLine containsCIS "cp ") AND (TgtProcCmdLine containsCIS "\Google\Chrome\User Data\" OR TgtProcCmdLine containsCIS "\Microsoft\Edge\User Data\") AND TgtProcCmdLine containsCIS "Login Data"))
