where((process.exe_path=/^.*\\cmd\.exe$/i OR process.exe_path=/^.*\\powershell\.exe$/i OR process.exe_path=/^.*\\pwsh\.exe$/i) AND (process.cmd_line=/^.*copy .*$/i OR process.cmd_line=/^.*Copy-Item.*$/i OR process.cmd_line=/^.*cp .*$/i) AND (process.cmd_line=/^.*\\Google\\Chrome\\User Data\\.*$/i OR process.cmd_line=/^.*\\Microsoft\\Edge\\User Data\\.*$/i) AND process.cmd_line=/^.*Login Data.*$/i)
