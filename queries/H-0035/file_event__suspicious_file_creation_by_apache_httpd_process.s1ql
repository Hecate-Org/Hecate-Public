ObjectType = "File" AND (EndpointOS = "linux" AND ((SrcProcImagePath endswithCIS "/httpd" OR SrcProcImagePath endswithCIS "/apache2") AND (TgtFilePath containsCIS "/var/www/" OR TgtFilePath containsCIS "/usr/share/nginx/html/" OR TgtFilePath containsCIS "/srv/http/" OR TgtFilePath containsCIS "/tmp/" OR TgtFilePath containsCIS "/dev/shm/") AND (NOT (TgtFilePath endswithCIS ".log" OR TgtFilePath endswithCIS ".pid" OR TgtFilePath endswithCIS ".lock"))))
