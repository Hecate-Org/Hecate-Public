where((parent_process.exe_path=/^.*\/httpd$/i OR parent_process.exe_path=/^.*\/apache2$/i) AND (process.exe_path=/^.*\/bin\/sh$/i OR process.exe_path=/^.*\/bin\/bash$/i OR process.exe_path=/^.*\/bin\/dash$/i OR process.exe_path=/^.*\/bin\/zsh$/i OR process.exe_path=/^.*\/usr\/bin\/python$/i OR process.exe_path=/^.*\/usr\/bin\/python3$/i OR process.exe_path=/^.*\/usr\/bin\/perl$/i OR process.exe_path=/^.*\/usr\/bin\/ruby$/i OR process.exe_path=/^.*\/usr\/bin\/php$/i))
